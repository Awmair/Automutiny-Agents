FIRM_NAME=Your Business Name
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Use groq for live runs or mock for deterministic local runs
MODEL_PROVIDER=groq
MODEL_ID=qwen/qwen3.6-27b
GROQ_API_KEY=

# Runtime limits
MIN_CONFIDENCE=0.6
MAX_MODEL_INPUT_CHARS=12000
MAX_OUTPUT_TOKENS=2000
MAX_RUN_TOKENS=12000
DAILY_GLOBAL_RUN_CAP=200
SESSION_RUN_CAP=10

# Required for the scheduled stalled-work route in production
CRON_SECRET=
