{
  "name": "automutiny-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @automutiny/web build",
    "dev": "pnpm --filter @automutiny/web dev",
    "eval": "node packages/evals/src/run.mjs eval",
    "eval:live": "node --env-file=apps/web/.env.local packages/evals/src/live-model-check.mjs",
    "eval:models": "node --env-file=apps/web/.env.local packages/evals/src/model-compare.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "pressure": "node packages/evals/src/run.mjs pressure",
    "redteam": "node packages/evals/src/run.mjs redteam",
    "release:check": "node packages/evals/src/run.mjs release --write",
    "seed": "pnpm --filter @automutiny/seed seed",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:live": "node scripts/verify-live-demos.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "supabase": "^2.116.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
